---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  description="Selected work from Floating Point Labs. Case studies of recent software engagements are coming soon."
  title="Projects — Floating Point Labs"
  variant="page">
  <main class="page">
    <header class="page__header">
      <p class="page__eyebrow">Projects</p>
      <h1 class="page__title">Selected work</h1>
      <p class="page__lede">A selection of recent work. More case studies coming soon.</p>
    </header>

    <section class="section">
      <div class="empty-state">
        <p class="empty-state__title">Case studies are on the way</p>
        <p class="empty-state__body">
          We're writing up recent engagements — the software we've shipped, who it helped, and how.
          In the meantime, <a href="/contact">get in touch</a> and we'll happily walk you through what
          we've been building.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
