---
import SectionHeader from "../components/SectionHeader.astro";
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const email = SITE.email;
---

<BaseLayout
  description="Get in touch with Floating Point Labs. We're open to new engagements and always happy to chat about upcoming work."
  title="Contact"
  variant="page">
  <div class="page">
    <header class="page__header">
      <p class="page__eyebrow">Contact</p>
      <h1 class="page__title">Let's talk</h1>
      <p class="page__lede">
        We're open to new engagements and always happy to chat about upcoming work. Drop us a line
        and we'll get back to you within a couple of business days.
      </p>
    </header>

    <section class="section">
      <SectionHeader index="01" title="Email" />
      <div class="panel">
        <p class="panel__label">Direct</p>
        <a class="home-preview__cta" href={`mailto:${email}`}>
          {email}
          <svg aria-hidden="true" fill="none" viewBox="0 0 16 16">
            <path
              d="M3 8h10m0 0L9 4m4 4l-4 4"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75">
            </path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
