---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  description="Get in touch with Floating Point Labs. We're open to new engagements and always happy to chat about upcoming work."
  title="Contact — Floating Point Labs"
  variant="page">
  <main class="page">
    <header class="page__header">
      <p class="page__eyebrow">Contact</p>
      <h1 class="page__title">Let's talk</h1>
      <p class="page__lede">
        We're open to new engagements and always happy to chat about upcoming work. Drop us a line
        and we'll get back to you within a couple of business days.
      </p>
    </header>

    <section class="section">
      <a class="home-preview__cta" href="mailto:hello@floatingpointlabs.ca">
        hello@floatingpointlabs.ca
        <svg aria-hidden="true" fill="none" viewBox="0 0 16 16">
          <path
            d="M3 8h10m0 0L9 4m4 4l-4 4"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.75">
          </path>
        </svg>
      </a>
    </section>
  </main>
</BaseLayout>
