---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Floating Point Labs" variant="page">
  <main class="page">
    <header class="page__header">
      <p class="page__eyebrow">About</p>
      <h1 class="page__title">A small studio for thoughtful software</h1>
      <p class="page__lede">
        We're a small studio building thoughtful software for teams that care about craft and
        clarity.
      </p>
    </header>

    <section class="section">
      <h2 class="section__title">What we do</h2>
      <p class="section__body">
        From early product exploration to production-grade systems, we partner with founders and
        established teams to ship software that is reliable, understandable, and a pleasure to
        maintain.
      </p>
    </section>

    <section class="section">
      <h2 class="section__title">How we work</h2>
      <p class="section__body">
        Small teams, tight feedback loops, and a bias toward shipping. We prefer simple designs that
        can evolve over complex abstractions that can't.
      </p>
    </section>

    <section class="section">
      <h2 class="section__title">Team</h2>
      <p class="section__body">Team details coming soon.</p>
    </section>
  </main>
</BaseLayout>
