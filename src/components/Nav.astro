---
import Wordmark from "./Wordmark.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Contact" }
];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<nav aria-label="Primary" class="site-nav">
  <a aria-label="Floating Point Labs — Home" class="site-nav__brand" href="/">
    <svg
      aria-hidden="true"
      class="site-nav__logo"
      focusable="false"
      viewBox="0 0 64 64"
      xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="nav-wave-grad" x1="0%" x2="100%" y1="0%" y2="0%">
          <stop offset="0%" stop-color="#6366f1"></stop>
          <stop offset="100%" stop-color="#a78bfa"></stop>
        </linearGradient>
        <radialGradient cx="38%" cy="32%" id="nav-dot-grad" r="65%">
          <stop offset="0%" stop-color="#b89cf7"></stop>
          <stop offset="100%" stop-color="#7c3aed"></stop>
        </radialGradient>
      </defs>
      <path
        d="M14 41q8.2-18.8 17.6-11.1t18 .3"
        fill="none"
        stroke="url(#nav-wave-grad)"
        stroke-linejoin="round"
        stroke-width="8.8">
      </path>
      <circle cx="40.8" cy="22.2" fill="url(#nav-dot-grad)" r="5.1"></circle>
    </svg>
    <Wordmark />
  </a>
  <ul class="site-nav__links">
    {
      links.map(({ href, label }) => (
        <li>
          <a
            aria-current={isActive(href) ? "page" : undefined}
            class:list={["site-nav__link", { "is-active": isActive(href) }]}
            href={href}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
