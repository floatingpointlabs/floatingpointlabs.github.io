<script>
  // Purely decorative ambient motion — skip entirely for reduced-motion users.
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!prefersReducedMotion) {
    startAsciiDrift();
  }

  function startAsciiDrift() {
    const canvas = document.createElement("canvas");
    Object.assign(canvas.style, {
      height: "100%",
      inset: "0",
      pointerEvents: "none",
      position: "fixed",
      width: "100%",
      zIndex: "1"
    });
    document.body.prepend(canvas);
    const ctx = canvas.getContext("2d")!;

    // Glyphs, unlike circles, show their edges — so back the canvas with the
    // device pixel ratio or the characters render soft on retina displays.
    let dpr = 1;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener("resize", resize);

    const palette = ["#a78bfa", "#818cf8", "#c4b5fd", "#6366f1", "#8b5cf6"];
    const glyphs = ".:-=+*#%@";
    const fontStack = '"Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace';

    const drifters = Array.from({ length: 18 }, () => ({
      baseAlpha: 0.16 + Math.random() * 0.16,
      char: glyphs[Math.floor(Math.random() * glyphs.length)],
      color: palette[Math.floor(Math.random() * palette.length)],
      size: 11 + Math.random() * 9,
      twinklePhase: Math.random() * Math.PI * 2,
      twinkleSpeed: 0.0003 + Math.random() * 0.0005,
      vx: (Math.random() - 0.5) * 0.1,
      vy: (Math.random() - 0.5) * 0.1,
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight
    }));

    let globalOpacity = 0;

    function draw(t: number) {
      const width = canvas.width / dpr;
      const height = canvas.height / dpr;

      ctx.clearRect(0, 0, width, height);
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      for (const d of drifters) {
        d.x += d.vx;
        d.y += d.vy;
        if (d.x < -20) d.x = width + 20;
        if (d.x > width + 20) d.x = -20;
        if (d.y < -20) d.y = height + 20;
        if (d.y > height + 20) d.y = -20;

        const twinkle = 0.55 + 0.45 * Math.sin(t * d.twinkleSpeed + d.twinklePhase);
        const a = d.baseAlpha * twinkle * globalOpacity;
        if (a < 0.005) continue;

        ctx.save();
        ctx.font = `${d.size}px ${fontStack}`;
        ctx.fillStyle = d.color;
        ctx.shadowColor = d.color;
        ctx.shadowBlur = 10;
        ctx.globalAlpha = a;
        ctx.fillText(d.char, d.x, d.y);
        ctx.restore();
      }

      requestAnimationFrame(draw);
    }

    const isSplash =
      document.body.classList.contains("variant-landing") &&
      !document.body.classList.contains("no-splash");
    const START_DELAY = isSplash ? 1900 : 0;
    const FADE_DUR = isSplash ? 1400 : 0;

    setTimeout(() => {
      if (FADE_DUR === 0) {
        globalOpacity = 1;
      } else {
        const t0 = performance.now();
        function fade(now: number) {
          globalOpacity = Math.min(1, (now - t0) / FADE_DUR);
          if (globalOpacity < 1) requestAnimationFrame(fade);
        }
        requestAnimationFrame(fade);
      }
      requestAnimationFrame(draw);
    }, START_DELAY);
  }
</script>
