---
import BackgroundGrid from "../components/BackgroundGrid.astro";
import Footer from "../components/Footer.astro";
import GlowDots from "../components/GlowDots.astro";
import Nav from "../components/Nav.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  variant?: "landing" | "page";
}

const { title = "Floating Point Labs", variant = "landing" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;700;800&family=Anek+Telugu:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={[`variant-${variant}`]}>
    <BackgroundGrid />
    <GlowDots />
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
